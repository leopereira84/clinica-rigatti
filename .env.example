# Configuration for `docker compose` (copy to .env in this folder).
# For the npm workflow without Docker, use backend/.env.example instead.

# Required. At least 32 random characters. Generate one with Docker:
#   docker run --rm node:22-alpine node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Password of the demo users created by `docker compose run --rm seed` (at least 8 characters).
SEED_PASSWORD=

# Optional. Only the backend container receives it. Empty = the AI assistant answers 503.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Port of the application on this machine: http://localhost:8080
FRONTEND_PORT=8080
