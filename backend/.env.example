NODE_ENV=development
PORT=3333

# MongoDB connection string. The database name goes before the "?".
# Must be a replica set (every MongoDB Atlas cluster is one): signup uses a transaction.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/catalog?retryWrites=true&w=majority

# At least 32 random characters. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=2h

# bcrypt work factor (4-15). Keep 12 or higher outside of tests.
BCRYPT_ROUNDS=12

# Frontend origin allowed by CORS (Vite dev server by default)
CORS_ORIGIN=http://localhost:5173

# AI assistant (OpenAI). Keep the key only in .env, never in code or Git.
# Without a key the API starts normally and POST /api/chat answers 503.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Timeout of each request to the LLM provider, in milliseconds
LLM_TIMEOUT_MS=20000

# Password shared by all demo users created by `npm run seed:apply`
# (at least 8 characters). Only used by the seed script.
SEED_PASSWORD=
